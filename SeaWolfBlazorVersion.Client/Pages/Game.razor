@page "/"
@layout GameLayout
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@implements IAsyncDisposable
@using System.Text.Json
@using System.Text.Json.Serialization
@using GameEngine.Engine
@using GameEngine.Engine.Models
@using GameEngine.Engine.Models.Enums
@inject IJSRuntime JS
@inject HighScoreService HighScoreService
@inject AudioService AudioService

<PageTitle>Sea Wolf</PageTitle>

<div id="game-container">
    <canvas id="gameCanvas" width="1280" height="720"></canvas>
</div>

@code {
    private readonly GameEngine _engine = new();
    private DotNetObjectReference<Game>? _dotNetRef;
    private DateTime _lastFrameTime;
    private bool _initialized;
    private bool _running;

    // Last known damage state per ship for audio triggers
    private readonly Dictionary<Guid, ShipDamageState> _lastDamageStates = new();
    private int _lastShipsSunk;
    private GameStatus _prevStatus = GameStatus.StartScreen;
    private bool _wasReloading;
    private bool _isSavingScore;

    private static readonly JsonSerializerOptions _jsonOptions = new()
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        Converters = { new JsonStringEnumConverter() }
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialized) return;
        _initialized = true;

        _engine.State.HighScore = await HighScoreService.LoadAsync();
        await RefreshHighScoreListAsync();

        _dotNetRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("SeaWolfRenderer.init", "gameCanvas");
        await JS.InvokeVoidAsync("SeaWolfInput.init", _dotNetRef, "gameCanvas");

        _lastFrameTime = DateTime.UtcNow;
        _running = true;

        // Start the client-side game loop driven by requestAnimationFrame
        await JS.InvokeVoidAsync("SeaWolfGameLoop.start", _dotNetRef);
    }

    [JSInvokable]
    public async Task OnFrame()
    {
        if (!_running || _isSavingScore) return;

        var now = DateTime.UtcNow;
        float dt = (float)(now - _lastFrameTime).TotalSeconds;
        _lastFrameTime = now;
        dt = Math.Clamp(dt, 0f, 0.1f);

        _engine.Update(dt);

        // Detect game over / campaign-complete transition → save high score once
        var newStatus = _engine.State.Status;
        if (!_isSavingScore)
        {
            if (_prevStatus != GameStatus.GameOver && newStatus == GameStatus.GameOver)
            {
                _prevStatus = newStatus;
                _isSavingScore = true;
                await AudioService.PlayGameOverAsync();
                await PromptAndSaveScoreAsync("Arcade");
                _engine.ReturnToStartScreen();
                _isSavingScore = false;
            }
            else if (_prevStatus != GameStatus.CampaignComplete && newStatus == GameStatus.CampaignComplete)
            {
                _prevStatus = newStatus;
                _isSavingScore = true;
                await PromptAndSaveScoreAsync("Campaign");
                _engine.ReturnToStartScreen();
                _isSavingScore = false;
            }
            else
            {
                _prevStatus = newStatus;
            }
        }

        await CheckAudioTriggers();

        var json = JsonSerializer.Serialize(_engine.State, _jsonOptions);
        await JS.InvokeVoidAsync("SeaWolfRenderer.renderFrame", json);
    }

    private async Task CheckAudioTriggers()
    {
        foreach (var ship in _engine.State.Ships)
        {
            if (_lastDamageStates.TryGetValue(ship.Id, out var prev))
            {
                if (prev != ship.DamageState)
                {
                    if (ship.DamageState == ShipDamageState.Burning)
                        await AudioService.PlaySmallExplosionAsync();
                    else if (ship.DamageState == ShipDamageState.Sinking)
                        await AudioService.PlayLargeExplosionAsync();
                }
            }
            _lastDamageStates[ship.Id] = ship.DamageState;
        }

        // Clean up stale ids
        var activeIds = _engine.State.Ships.Select(s => s.Id).ToHashSet();
        foreach (var key in _lastDamageStates.Keys.Where(k => !activeIds.Contains(k)).ToList())
            _lastDamageStates.Remove(key);

        // Reload complete
        if (_wasReloading && !_engine.State.IsReloading)
            await AudioService.PlayReloadCompleteAsync();
        _wasReloading = _engine.State.IsReloading;

        // Wave clear audio
        if (_engine.State.Status == GameStatus.WaveClear && _lastShipsSunk != _engine.State.ShipsSunkThisWave)
        {
            _lastShipsSunk = _engine.State.ShipsSunkThisWave;
            await AudioService.PlayWaveClearAsync();
        }
    }

    [JSInvokable]
    public void OnMouseMove(double x, double y)
    {
        _engine.State.MouseX = (float)x;
        _engine.State.MouseY = (float)y;
        _engine.State.SelectedTube = _engine.ComputeAimedTube((float)x, (float)y);
    }

    [JSInvokable]
    public async Task OnClick(double x, double y)
    {
        var status = _engine.State.Status;

        if (status == GameStatus.StartScreen)
        {
            var btns = await JS.InvokeAsync<JsonElement>("SeaWolfHighScore.getStartScreenButtons");

            if (HitTest(btns, "highScores", x, y))
            {
                await JS.InvokeVoidAsync("SeaWolfHighScore.toggleHighScores");
                return;
            }
            if (HitTest(btns, "arcade", x, y))
            {
                _engine.State.HighScore = await HighScoreService.LoadAsync();
                _engine.StartGame();
                return;
            }
            if (HitTest(btns, "campaign", x, y))
            {
                _engine.State.HighScore = await HighScoreService.LoadAsync();
                _engine.StartCampaign();
                return;
            }
            return;
        }

        if (status == GameStatus.GameOver)
            return;

        if (status == GameStatus.MissionBriefing)
        {
            _engine.AdvanceMissionBriefing();
            return;
        }

        if (status == GameStatus.MissionComplete || status == GameStatus.CampaignComplete)
        {
            _engine.AdvanceToNextMission();
            return;
        }

        if (status == GameStatus.Playing)
        {
            if (_engine.FireTorpedoFromTube(_engine.State.SelectedTube))
                await AudioService.PlayTorpedoAsync();
        }
    }

    [JSInvokable]
    public async Task OnKeyDown(string key)
    {
        if (key == "p" || key == "P")
        {
            _engine.TogglePause();
            return;
        }

        if (key == " " || key == "Enter")
        {
            var status = _engine.State.Status;
            if (status == GameStatus.MissionBriefing)
            {
                _engine.AdvanceMissionBriefing();
                return;
            }
            if (status == GameStatus.MissionComplete || status == GameStatus.CampaignComplete)
            {
                _engine.AdvanceToNextMission();
                return;
            }
        }

        if (key == "c" || key == "C")
        {
            if (_engine.State.Status == GameStatus.StartScreen)
            {
                _engine.State.HighScore = await HighScoreService.LoadAsync();
                _engine.StartCampaign();
                return;
            }
        }

        if (key == "h" || key == "H")
        {
            if (_engine.State.Status == GameStatus.StartScreen)
            {
                await JS.InvokeVoidAsync("SeaWolfHighScore.toggleHighScores");
                return;
            }
        }

        if (_engine.State.Status == GameStatus.Playing)
        {
            switch (key)
            {
                case "ArrowLeft":
                    _engine.State.SelectedTube = Math.Max(0, _engine.State.SelectedTube - 1);
                    break;
                case "ArrowRight":
                    _engine.State.SelectedTube = Math.Min(4, _engine.State.SelectedTube + 1);
                    break;
                case " ":
                    if (_engine.FireTorpedoFromTube(_engine.State.SelectedTube))
                        await AudioService.PlayTorpedoAsync();
                    break;
            }
        }
    }

    private static bool HitTest(JsonElement btns, string key, double x, double y)
    {
        if (btns.ValueKind != JsonValueKind.Object) return false;
        if (!btns.TryGetProperty(key, out var box)) return false;
        if (box.ValueKind == JsonValueKind.Null) return false;
        var bx = box.GetProperty("x").GetDouble();
        var by = box.GetProperty("y").GetDouble();
        var bw = box.GetProperty("w").GetDouble();
        var bh = box.GetProperty("h").GetDouble();
        return x >= bx && x <= bx + bw && y >= by && y <= by + bh;
    }

    private async Task PromptAndSaveScoreAsync(string mode)
    {
        var score = _engine.State.Score;
        if (score <= 0) return;

        var name = await JS.InvokeAsync<string?>("SeaWolfHighScore.promptName", score);
        name = string.IsNullOrWhiteSpace(name) ? "UNKNOWN" : name;

        await HighScoreService.AddEntryAsync(name, score, mode);
        _engine.State.HighScore = await HighScoreService.LoadAsync();
        await RefreshHighScoreListAsync();

        _lastFrameTime = DateTime.UtcNow;
    }

    private async Task RefreshHighScoreListAsync()
    {
        var list = await HighScoreService.LoadListAsync();
        _engine.State.HighScoreList = list
            .Select(e => new HighScoreEntryDto(e.Name, e.Score, e.Mode))
            .ToList();
    }

    // Exposed for bUnit tests only — not part of the public API
    internal GameEngine Engine => _engine;

    public async ValueTask DisposeAsync()
    {
        _running = false;

        if (_initialized)
        {
            await JS.InvokeVoidAsync("SeaWolfGameLoop.stop");
        }

        _dotNetRef?.Dispose();
    }
}
